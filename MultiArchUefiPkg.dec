[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = MultiArchUefiPkg
  PACKAGE_GUID                   = 1E73767F-8F52-4603-AEB4-F29B510B6733
  PACKAGE_VERSION                = 1.00

[Includes]
  Include

[Guids]
  gMauPkgTokenSpaceGuid = { 0xA2E42AAE, 0x641C, 0x444D, { 0xBB, 0x13, 0x47, 0xA4, 0x8F, 0xA7, 0x19, 0xF9 }}

[PcdsFixedAtBuild, PcdsDynamic, PcdsDynamicEx]
  ## Allow the platform to disable all compiled-in guest architectures.
  # Bind to a platform setup variable with DynamicHii or DynamicExHii.
  gMauPkgTokenSpaceGuid.PcdMauEmulationEnabled|TRUE|BOOLEAN|0x0001
